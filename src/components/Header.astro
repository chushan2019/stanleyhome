---
import { withBase } from '../utils/base';

const links = [
  { href: withBase('/works'), label: '作品集' },
  { href: withBase('/notes'), label: '读书笔记' },
  { href: withBase('/blog'), label: '博客' },
  { href: withBase('/about'), label: '关于我' },
];
const home = withBase('/');
const path = Astro.url.pathname;
---

<header class="sh-header">
  <div class="sh-container bar">
    <a href={home} class="brand" aria-label="返回首页">
      <span class="mark">初山</span>
      <span class="name">STANLEY</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        links.map((l) => {
          const active = path === l.href || path.startsWith(l.href + '/');
          return (
            <a href={l.href} class:list={['nav-link', { active }]}>
              {l.label}
            </a>
          );
        })
      }
    </nav>

    <div class="actions">
      <button class="theme-toggle" data-theme-toggle aria-label="切换深浅主题">
        <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button class="menu-btn" id="menu-btn" aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    {
      links.map((l) => (
        <a href={l.href} class="mobile-link">
          {l.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  .sh-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--sh-bg-page) 72%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--sh-border-subtle);
    transition: background-color 0.5s ease;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--sh-space-4);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .mark {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .name {
    font-family: var(--sh-font-display);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--sh-text-description);
  }

  .brand:hover .name {
    color: var(--sh-brand);
    transition: color 0.2s ease;
  }

  .nav {
    display: flex;
    gap: var(--sh-space-6);
  }

  .nav-link {
    font-size: 14px;
    color: var(--sh-text-description);
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--sh-text-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 50%;
    translate: -50%;
    bottom: -22px;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: var(--sh-brand);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sh-space-2);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--sh-border-default);
    background: var(--sh-bg-surface-1);
    color: var(--sh-text-secondary);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .theme-toggle:hover {
    background: var(--sh-bg-hover);
    color: var(--sh-text-primary);
  }

  /* 深浅各显示一个图标 */
  .i-sun {
    display: none;
  }

  :global([data-theme='light']) .i-sun {
    display: block;
  }

  :global([data-theme='light']) .i-moon {
    display: none;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    border: 1px solid var(--sh-border-default);
    border-radius: 50%;
    background: var(--sh-bg-surface-1);
    cursor: pointer;
    align-items: center;
  }

  .menu-btn span {
    width: 14px;
    height: 1.5px;
    background: var(--sh-text-primary);
    transition: transform 0.25s ease;
  }

  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    padding: var(--sh-space-2) 0 var(--sh-space-4);
    border-bottom: 1px solid var(--sh-border-subtle);
    background: var(--sh-bg-page);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-link {
    padding: 12px 24px;
    font-size: 15px;
    color: var(--sh-text-secondary);
  }

  .mobile-link:hover {
    color: var(--sh-brand);
  }

  @media (max-width: 767px) {
    .nav {
      display: none;
    }

    .menu-btn {
      display: flex;
    }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.toggleAttribute('hidden', open);
  });
</script>
