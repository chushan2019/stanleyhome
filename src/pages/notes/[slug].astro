---
import { withBase } from '../../utils/base';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const link = (p: string) => withBase(p);
---

<BaseLayout title={`${note.data.book} · 读书笔记 · Stanley · 初山`} description={note.data.summary}>
  <article class="sh-section">
    <div class="sh-container narrow">
      <a class="back sh-link t-caption" href={link('/notes')}>← 返回书目</a>

      <header class="head sh-enter">
        <span class="kicker t-mono">读书笔记 · {note.data.status === 'done' ? `读完于 ${note.data.doneDate ?? ''}` : '在读中'}</span>
        <h1 class="t-h1">《{note.data.book}》</h1>
        <p class="au">[ {note.data.author} ]</p>
        <p class="t-subtitle sum">{note.data.summary}</p>
      </header>

      {
        note.data.quotes.length > 0 && (
          <section class="quotes sh-enter" style="--enter-delay:.1s">
            <h2 class="q-title t-mono">金句摘录</h2>
            <div class="q-grid">
              {note.data.quotes.map((q) => (
                <blockquote class="q">{q}</blockquote>
              ))}
            </div>
          </section>
        )
      }

      <div class="sh-prose sh-enter" style="--enter-delay:.18s">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .back {
    display: inline-block;
    margin-bottom: var(--sh-space-7);
    color: var(--sh-text-description);
  }

  .kicker {
    color: var(--sh-brand);
    display: block;
    margin-bottom: var(--sh-space-3);
  }

  .au {
    margin: var(--sh-space-2) 0 0;
    color: var(--sh-text-description);
    font-size: 14px;
  }

  .sum {
    margin-top: var(--sh-space-5);
    color: var(--sh-text-description);
    max-width: 52ch;
  }

  .quotes {
    margin-top: var(--sh-space-8);
  }

  .q-title {
    color: var(--sh-text-placeholder);
    margin-bottom: var(--sh-space-4);
  }

  .q-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sh-space-4);
  }

  .q {
    margin: 0;
    padding: var(--sh-space-5);
    border: 1px solid var(--sh-border-default);
    border-radius: var(--sh-radius-panel);
    background: var(--sh-bg-surface-3);
    font-size: 15px;
    line-height: 1.7;
    color: var(--sh-text-secondary);
    position: relative;
    transition: border-color 0.2s ease, transform 0.3s ease;
  }

  .q:hover {
    border-color: var(--sh-border-hover);
    transform: translateY(-2px);
  }

  .q::before {
    content: '“';
    font-family: var(--sh-font-display);
    color: var(--sh-brand);
    font-size: 28px;
    line-height: 1;
    display: block;
    margin-bottom: 6px;
  }

  @media (max-width: 639px) {
    .q-grid {
      grid-template-columns: 1fr;
    }
  }

  .sh-prose {
    margin-top: var(--sh-space-9);
    padding-top: var(--sh-space-8);
    border-top: 1px solid var(--sh-border-subtle);
  }
</style>
