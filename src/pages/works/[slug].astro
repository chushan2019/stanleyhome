---
import { withBase } from '../../utils/base';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { workTypeLabel } from '../../utils/labels';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((w) => ({ params: { slug: w.id }, props: { work: w } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const link = (p: string) => withBase(p);
---

<BaseLayout title={`${work.data.title} · 作品集 · Stanley · 初山`} description={work.data.summary}>
  <article class="sh-section">
    <div class="sh-container narrow">
      <a class="back sh-link t-caption" href={link('/works')}>← 返回作品集</a>

      <header class="head sh-enter" style="--enter-delay:0s">
        <span class="kicker t-mono">{workTypeLabel[work.data.type]} · {work.data.year ?? ''}</span>
        <h1 class="t-h1">{work.data.title}</h1>
        <p class="t-subtitle sum">{work.data.summary}</p>
        {
          work.data.external && (
            <p class="ext">
              <a class="sh-btn sh-btn-secondary" href={work.data.external} target="_blank" rel="noopener">
                {work.data.type === 'audio' ? '去收听' : work.data.type === 'video' ? '去观看' : '阅读原文'}{' '}
                <span class="arrow">↗</span>
              </a>
              {work.data.duration && <span class="dur t-mono">{work.data.duration}</span>}
            </p>
          )
        }
      </header>

      {
        work.data.cover && (
          <div class="cover sh-window sh-enter" style="--enter-delay:.12s">
            <div class="sh-window-titlebar">
              <i class="sh-window-dot" /><i class="sh-window-dot" /><i class="sh-window-dot" />
            </div>
            <img src={withBase(work.data.cover)} alt={work.data.title} />
          </div>
        )
      }

      <div class="sh-prose sh-enter" style="--enter-delay:.2s">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .narrow {
    max-width: 820px;
  }

  .back {
    display: inline-block;
    margin-bottom: var(--sh-space-7);
    color: var(--sh-text-description);
  }

  .head .kicker {
    color: var(--sh-brand);
    display: block;
    margin-bottom: var(--sh-space-3);
  }

  .sum {
    margin-top: var(--sh-space-4);
    color: var(--sh-text-description);
  }

  .ext {
    display: flex;
    align-items: center;
    gap: var(--sh-space-4);
    margin: var(--sh-space-6) 0 0;
  }

  .ext p,
  .ext {
    margin-bottom: 0;
  }

  .dur {
    color: var(--sh-text-placeholder);
  }

  .cover {
    margin-top: var(--sh-space-8);
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 8 / 4.4;
    object-fit: cover;
  }

  .sh-prose {
    margin-top: var(--sh-space-8);
  }
</style>
