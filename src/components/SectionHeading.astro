---
/** 原站 section 头模式：mono 小标签 + 大标题 + 可选描述 */
interface Props {
  kicker: string;
  title: string;
  desc?: string;
}

const { kicker, title, desc } = Astro.props;
---

<div class="sh-heading" data-kicker>
  <span class="kicker t-mono">{kicker}</span>
  <h2 class="t-h1">{title}</h2>
  {desc && <p class="t-subtitle desc">{desc}</p>}
</div>

<style>
  .sh-heading {
    margin-bottom: var(--sh-space-8);
  }

  .kicker {
    color: var(--sh-brand);
    display: block;
    margin-bottom: var(--sh-space-3);
  }

  .desc {
    margin-top: var(--sh-space-4);
    color: var(--sh-text-description);
    max-width: 56ch;
  }
</style>
