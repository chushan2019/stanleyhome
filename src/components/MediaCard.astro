---
/**
 * 媒体卡片 —— 对应原站 8/5 封面的特性卡：
 * 可选 macOS 窗口壳（壳红绿灯包裹截图/图形类内容）、类型角标、hover 抬升
 */
interface Props {
  href: string;
  title: string;
  desc?: string;
  cover?: string;
  /** 角标：图文 / 音频 / 视频 / 书名等 */
  tag?: string;
  meta?: string;
  /** 用 macOS 窗口壳包住封面 */
  window?: boolean;
}

const { href, title, desc, cover, tag, meta, window: useWindow = false } = Astro.props;
---

<a class="card" {href}>
  <div class="media" class:list={{ shell: useWindow }}>
    {
      useWindow ? (
        <div class="sh-window">
          <div class="sh-window-titlebar">
            <i class="sh-window-dot" /><i class="sh-window-dot" /><i class="sh-window-dot" />
          </div>
          <div class="img-wrap">
            {cover ? <img src={cover} alt={title} loading="lazy" /> : <div class="ph" />}
          </div>
        </div>
      ) : (
        <div class="img-wrap">
          {cover ? <img src={cover} alt={title} loading="lazy" /> : <div class="ph" />}
        </div>
      )
    }
    {tag && <span class="badge">{tag}</span>}
  </div>

  <div class="body">
    <div class="line">
      <h3 class="t-title">{title}</h3>
      <span class="arrow" aria-hidden="true">→</span>
    </div>
    {desc && <p class="t-caption desc">{desc}</p>}
    {meta && <span class="meta t-mono">{meta}</span>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--sh-space-4);
    padding: var(--sh-space-4);
    border-radius: var(--sh-radius-card);
    border: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease,
      transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .card:hover {
    background: var(--sh-bg-surface-3);
    border-color: var(--sh-border-default);
    transform: translateY(-3px);
  }

  .media {
    position: relative;
  }

  .img-wrap {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border-radius: var(--sh-radius-media);
    border: 1px solid var(--sh-border-default);
    background: var(--sh-bg-surface-3);
  }

  .shell .img-wrap {
    border: none;
    border-radius: 0;
  }

  .shell .sh-window {
    border-radius: var(--sh-radius-media);
  }

  .img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .card:hover .img-wrap img {
    transform: scale(1.025);
  }

  /* 无封面时的占位渐变 */
  .ph {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--sh-brand) 22%, transparent), transparent 60%),
      linear-gradient(160deg, #16181d, #0d0e11);
  }

  :root[data-theme='light'] .ph {
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in srgb, var(--sh-brand) 18%, transparent), transparent 60%),
      linear-gradient(160deg, #ffffff, #eef0f4);
  }

  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    font-family: var(--sh-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 5px 9px 4px;
    border-radius: 7px;
    background: rgba(0, 0, 0, 0.25);
    color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* 窗口壳模式下避开左上角红绿灯 */
  .media.shell .badge {
    left: auto;
    right: 10px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--sh-space-2);
    padding: 0 var(--sh-space-1);
  }

  .line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sh-space-3);
  }

  .arrow {
    color: var(--sh-text-placeholder);
    transition: transform 0.3s ease, color 0.2s ease;
  }

  .card:hover .arrow {
    color: var(--sh-brand);
    transform: translateX(3px);
  }

  .desc {
    color: var(--sh-text-description);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    color: var(--sh-text-placeholder);
    text-transform: none;
    letter-spacing: 0.04em;
  }
</style>
